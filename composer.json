{
    "name": "diego-piedrahita/php-sast-demo",
    "description": "Proyecto demo (login + registro de productos) con vulnerabilidades intencionales para probar SAST en PHP sin CodeQL/SonarQube",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "vimeo/psalm": "^5.26",
        "squizlabs/php_codesniffer": "^4.0",
        "pheromone/phpcs-security-audit": "^2.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "scripts": {
        "sast:psalm": "psalm --taint-analysis --report=psalm-results.sarif",
        "sast:phpcs": "phpcs --standard=phpcs.xml --report=json --report-file=phpcs-results.json src"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}